---
import "@fontsource/source-serif-4/600.css";
import "@fontsource/source-serif-4/700.css";
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "../styles/global.css";
import { siteConfig } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs, { type BreadcrumbItem } from "../components/Breadcrumbs.astro";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import MetaPixel from "../components/MetaPixel.astro";
import MobileBottomNav from "../components/MobileBottomNav.astro";
import { GOOGLE_SITE_VERIFICATION } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  /** Use when a page is a near-duplicate of another page and should point search engines to it. */
  canonicalOverride?: string;
  noindex?: boolean;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  productJsonLd?: Record<string, unknown> | null;
  faqJsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  canonicalOverride,
  noindex = false,
  ogImage,
  breadcrumbs = [],
  productJsonLd = null,
  faqJsonLd = null,
} = Astro.props;

const defaultOgImage =
  canonicalPath === "/404.html"
    ? "/og/og-1200x630.jpg"
    : `/og/pages/${canonicalPath === "/" ? "home" : canonicalPath.replace(/^\//, "").replace(/\/$/, "").replaceAll("/", "-")}.jpg`;
const canonicalUrl = new URL(canonicalOverride ?? canonicalPath, siteConfig.url).toString();
const absoluteOgImage = new URL(ogImage ?? defaultOgImage, siteConfig.url).toString();
const pageKind =
  canonicalPath === "/"
    ? "home"
    : canonicalPath === "/shop/"
    ? "shop"
    : canonicalPath.startsWith("/shop/")
      ? "product"
      : canonicalPath === "/guides/"
        ? "guides"
        : canonicalPath.startsWith("/guides/")
          ? "guide"
          : canonicalPath === "/contact/"
            ? "contact"
            : canonicalPath === "/faq/"
              ? "faq"
              : canonicalPath === "/free-sample/"
                ? "sample"
                : canonicalPath === "/about/"
                  ? "about"
                  : "article";

const sameAsLinks = siteConfig.social.filter((item) => item.live).map((item) => item.url);

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteConfig.url,
  logo: new URL("/images/brand/logo-1024.png", siteConfig.url).toString(),
  description: siteConfig.tagline,
  ...(sameAsLinks.length > 0 ? { sameAs: sameAsLinks } : {}),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.tagline,
};

const webpageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: { "@type": "WebSite", name: siteConfig.name, url: siteConfig.url },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

    <!-- Favicons & Web App Manifest -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#015A67" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={`${title} — ${siteConfig.name}`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={`${title} — ${siteConfig.name}`} />

    <!-- Organization JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webpageJsonLd)} />

    <!-- Optional Product JSON-LD (only when status === 'live') -->
    {
      productJsonLd && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(productJsonLd)} />
      )
    }

    {
      faqJsonLd && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
      )
    }

    <!-- Disabled-by-default Analytics Components -->
    <CloudflareAnalytics />
    <MetaPixel />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink">
    <div id="site-loading" class="site-loading" hidden aria-live="polite" aria-busy="true">
      <div class="site-loading-bar" aria-hidden="true"></div>
      <div class="site-loading-content" role="status">
        <div class="loading-spinner" aria-hidden="true"></div>
        <p class="site-loading-title">Loading page</p>
        <p class="site-loading-subtitle">Just a moment…</p>
        <div class:list={["page-skeleton", `page-skeleton-${pageKind}`]} aria-hidden="true">
          {
            pageKind === "home" ? (
              <>
                <div class="skeleton-hero-copy"><span></span><span></span><span></span><span class="short"></span></div>
                <div class="skeleton-hero-image"></div>
              </>
            ) : pageKind === "shop" ? (
              <div class="skeleton-card-grid">{[1, 2, 3].map(() => <div class="skeleton-product-card"><span class="skeleton-card-image"></span><span></span><span></span><span class="short"></span><i></i><i></i></div>)}</div>
            ) : pageKind === "product" ? (
              <div class="skeleton-product-detail"><span class="skeleton-detail-image"></span><div><span></span><span></span><span></span><span class="short"></span><i></i></div></div>
            ) : pageKind === "contact" ? (
              <div class="skeleton-form"><span></span><i></i><span></span><i class="tall"></i><i></i></div>
            ) : pageKind === "faq" ? (
              <div class="skeleton-faq">{[1, 2, 3, 4].map(() => <span></span>)}</div>
            ) : (
              <div class="skeleton-article"><span></span><span></span><span></span><span class="wide"></span><span></span><span class="short"></span></div>
            )
          }
        </div>
      </div>
    </div>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    <Header currentPath={canonicalPath} />
    <MobileBottomNav currentPath={canonicalPath} />

    <main id="main-content" tabindex="-1" class="flex-1">
      {
        breadcrumbs.length > 0 ? (
          <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 lg:px-8">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        ) : (
          <Breadcrumbs items={[]} />
        )
      }
      <slot />
    </main>

    <Footer />
  </body>
</html>

<script>
  const loadingOverlay = document.getElementById("site-loading");

  function showPageLoading(label = "Loading page") {
    if (!loadingOverlay) return;
    const title = loadingOverlay.querySelector<HTMLElement>(".site-loading-title");
    if (title) title.textContent = label;
    loadingOverlay.hidden = false;
    document.documentElement.classList.add("is-loading");
  }

  function hidePageLoading() {
    if (!loadingOverlay) return;
    loadingOverlay.hidden = true;
    document.documentElement.classList.remove("is-loading");
  }

  window.addEventListener("pageshow", hidePageLoading);

  document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        link.target === "_blank" ||
        link.hasAttribute("download")
      ) return;

      const href = link.getAttribute("href") || "";
      if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) return;

      try {
        const destination = new URL(href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        showPageLoading("Loading page");
      } catch {
        return;
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>("a.btn[href]").forEach((button) => {
    button.addEventListener("click", () => {
      if (button.dataset.loadingReady === "true") return;
      button.dataset.loadingReady = "true";
      button.setAttribute("aria-busy", "true");
      button.classList.add("is-loading-button");
      const original = button.innerHTML;
      button.dataset.originalLabel = original;
      button.innerHTML = '<span class="button-spinner" aria-hidden="true"></span><span>Opening…</span>';
    });
  });

  const shareButtons = document.querySelectorAll<HTMLButtonElement>("[data-share-url]");

  shareButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const url = button.dataset.shareUrl || window.location.href;
      const title = button.dataset.shareTitle || document.title;
      const text = button.dataset.shareText || "Take a look at this from Caring for Aging Parents.";
      const label = button.querySelector<HTMLElement>("[data-share-label]");

      try {
        if (navigator.share) {
          await navigator.share({ title, text, url });
          return;
        }
        await navigator.clipboard.writeText(url);
        if (label) {
          const previous = label.textContent;
          label.textContent = "Link copied";
          window.setTimeout(() => {
            label.textContent = previous || "Share";
          }, 2200);
        }
      } catch (error) {
        if ((error as DOMException).name !== "AbortError") {
          window.prompt("Copy this link to share:", url);
        }
      }
    });
  });
</script>
