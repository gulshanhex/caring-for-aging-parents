---
import "../styles/global.css";
import { siteConfig } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs, { type BreadcrumbItem } from "../components/Breadcrumbs.astro";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import MetaPixel from "../components/MetaPixel.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  productJsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = "/og/og-1200x630.jpg",
  breadcrumbs = [],
  productJsonLd = null,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, siteConfig.url).toString();
const absoluteOgImage = new URL(ogImage, siteConfig.url).toString();

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteConfig.url,
  logo: new URL("/images/brand/logo-1024.png", siteConfig.url).toString(),
  description: siteConfig.tagline,
  sameAs: [siteConfig.social.facebookUrl, siteConfig.social.pinterestUrl],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & Web App Manifest -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#015A67" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Organization JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />

    <!-- Optional Product JSON-LD (only when status === 'live') -->
    {
      productJsonLd && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(productJsonLd)} />
      )
    }

    <!-- Disabled-by-default Analytics Components -->
    <CloudflareAnalytics />
    <MetaPixel />
  </head>
  <body class=" flex min-h-screen flex-col bg-[#FFFFFF] text-[#111111]">
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    <Header currentPath={canonicalPath} />

    <main id="main-content" tabindex="-1" class="flex-1">
      {
        breadcrumbs.length > 0 ? (
          <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 lg:px-8">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        ) : (
          <Breadcrumbs items={[]} />
        )
      }
      <slot />
    </main>

    <Footer />
  </body>
</html>
