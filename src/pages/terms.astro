---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
import NoticeBox from "../components/NoticeBox.astro";
---
<BaseLayout
  title="Terms of Use | Caring for Aging Parents"
  description="Plain-language terms for our printable PDF sheets: personal and family use, no reselling, and what to do if you have trouble with a download."
  canonicalPath="/terms/"
  ogImage="/og/og-1200x630.jpg"
  breadcrumbs={[{ label: "Terms of Use", href: "/terms/" }]}
>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="prose-measure space-y-8">
      <h1 class="font-serif text-teal">
        Terms of use (in plain language)
      </h1>
      <p class="text-ink">
        These terms explain how you may use the printable PDF sheets from <strong>{siteConfig.name}</strong>. They are short on purpose.
      </p>

      <section>
        <h2 class="font-serif text-teal">
          1. What you are getting
        </h2>
        <p class="mt-3 text-ink">
          Each printable is a digital PDF file. You download it after checkout on Gumroad and print it yourself. We do not mail any paper or physical item.
        </p>
      </section>

      <section>
        <h2 class="font-serif text-teal">
          2. How you may use the files
        </h2>
        <p class="mt-3 text-ink">
          You may print the pages as many times as you need for yourself and the family and helpers who share the care of your parent, and fill them in by hand.
        </p>
      </section>

      <section>
        <h2 class="font-serif text-teal">
          3. What you may not do
        </h2>
        <ul class="mt-4 list-disc space-y-3 pl-6 text-ink">
          <li>Resell the PDF files or printed copies of them.</li>
          <li>Share the files publicly, post them online, or give copies to people outside your family.</li>
          <li>Present our sheets as your own work.</li>
        </ul>
        <p class="mt-4 text-ink">
          If a friend would like the same sheets, please send them to our website.
        </p>
      </section>

      <section>
        <h2 class="font-serif text-teal">
          4. Organizational tools only
        </h2>
        <NoticeBox title="Important limitation">
          Our sheets are organizational tools. <mark class="notice-highlight">They are not medical, legal, or financial advice.</mark>{" "}
          Please read our <a href="/disclaimer/">disclaimer</a>.
        </NoticeBox>
      </section>

      <section>
        <h2 class="font-serif text-teal">
          5. Refunds and download problems
        </h2>
        <p class="mt-3 text-ink">
          Refund terms are shown on the Gumroad page of each product before you buy. If you have trouble downloading or opening a file, email us at <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> and we will do our best to help.
        </p>
      </section>

      <section>
        <h2 class="font-serif text-teal">
          6. Changes
        </h2>
        <p class="mt-3 text-ink">
          We may update these terms from time to time. The date below shows when they last changed.
        </p>
      </section>

      <p class="text-muted">
        Last updated: 11 November 2026.
      </p>
    </div>
  </article>
</BaseLayout>
