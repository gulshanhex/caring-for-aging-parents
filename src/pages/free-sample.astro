---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
---
<BaseLayout
  title="Free Sample Printable Page | Caring for Aging Parents"
  description="Download a $0 large-print family caregiving sample sheet to test our font size and handwriting boxes on your own home printer."
  canonicalPath="/free-sample/"
  breadcrumbs={[{ label: "Free Sample", href: "/free-sample/" }]}
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7 prose-measure">
        <h1 class="font-serif text-[#015A67]">
          Free sample large-print caregiving sheet
        </h1>

        <p class="mt-4 text-[#111111]">
          Before you buy a full pack of sheets, we want you to see how our large print looks on your own kitchen table. Our free sample is a single US Letter PDF page that you can download for $0 through Gumroad and print at home right now.
        </p>

        <h2 class="mt-8 font-serif text-[#015A67]">
          What is on the free sample page
        </h2>
        <ul class="mt-4 list-disc space-y-3 pl-6 text-[#111111]">
          <li>
            <strong>Today's Quick Handover Box:</strong> Roomy lines to jot down today's date, who visited, and two or three simple household updates for the next sibling or helper.
          </li>
          <li>
            <strong>Three Essential Phone Number Boxes:</strong> Large, high-contrast spaces to write down three everyday family or neighbor phone numbers and test how easy they are to read at arm's length.
          </li>
          <li>
            <strong>Errands &amp; Groceries Needed Box:</strong> A clean checklist area so anyone stopping by knows what to pick up on the way over.
          </li>
        </ul>

        <h2 class="mt-8 font-serif text-[#015A67]">
          How to test it in 30 seconds
        </h2>
        <p class="mt-3 text-[#111111]">
          Print the page in black and white at 100% scale (Actual Size). Hold the sheet at arm's length under your normal kitchen light and fill in one box with a pen. You will know right away if the print size and line spacing feel comfortable for your family.
        </p>

        <div class="mt-8">
          <a
            href={siteConfig.freeSampleUrl}
            class="btn btn-cta w-full text-center sm:w-auto"
            rel="noopener noreferrer"
          >
            Get the free sample sheet ($0 on Gumroad)
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-xl border-2 border-[#D8D5C5] bg-[#FAF8EC]">
          <img
            src="/images/sample/free-sample.webp"
            width="1200"
            height="900"
            alt="Flat illustration of printed sample sheets fanned out on a wooden desk beside a pen."
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
