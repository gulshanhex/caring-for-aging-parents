---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
import NoticeBox from "../components/NoticeBox.astro";
---
<BaseLayout
  title="Contact Us | Caring for Aging Parents"
  description="Send a question, a request, or a thought about our large-print family caregiving sheets. Write it here and your own email opens with it ready to send."
  canonicalPath="/contact/"
  breadcrumbs={[{ label: "Contact", href: "/contact/" }]}
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="prose-measure space-y-8">
      <h1 class="font-serif text-teal">
        Contact us
      </h1>
      <p class="text-ink">
        Have a question about one of our printable sheets, need help getting a PDF to print at full size, or had trouble with your Gumroad download link? Write to us. You can also ask for a printable you wish existed, or share a thought about what would help your family.
      </p>

      <div class="rounded-xl border-2 border-teal bg-cream p-6 sm:p-8">
        <h2 class="font-serif text-teal">
          Email us directly
        </h2>
        <p class="mt-3 text-ink">
          Tap or click the address to open a new email:
        </p>
        <p class="mt-3 font-serif text-xl font-bold">
          <a href={`mailto:${siteConfig.contactEmail}`}>
            {siteConfig.contactEmail}
          </a>
        </p>
      </div>

      <div class="rounded-xl border-2 border-warm-border bg-canvas p-6 sm:p-8">
        <h2 class="font-serif text-teal">
          Or write your message here
        </h2>
        <p class="mt-3 text-ink">
          Fill in the two boxes and press the button. Your own email opens with the address, subject, and message already filled in. Choose which email account to send from, then press <strong>Send</strong>.
        </p>

        <noscript>
          <p class="mt-4 rounded-xl border-2 border-brown bg-cream p-4 text-ink">
            This form needs JavaScript. Please use the email address above instead.
          </p>
        </noscript>

        <form id="contact-form" class="mt-6 space-y-6" novalidate hidden data-to={siteConfig.contactEmail}>
          <div>
            <label for="contact-subject" class="form-label">Subject</label>
            <input
              id="contact-subject"
              name="subject"
              type="text"
              class="form-input"
              maxlength="120"
              autocomplete="off"
              required
              aria-describedby="subject-error"
              placeholder="For example: Question about printing"
            />
            <p id="subject-error" class="form-error" hidden></p>
          </div>

          <div>
            <label for="contact-message" class="form-label">Your message</label>
            <textarea
              id="contact-message"
              name="message"
              class="form-input"
              rows="8"
              maxlength="1500"
              required
              aria-describedby="message-hint message-error"
            ></textarea>
            <p id="message-hint" class="form-hint">
              Up to 1,500 characters. Please do not include passwords, account numbers, or personal health details.
            </p>
            <p id="message-error" class="form-error" hidden></p>
          </div>

          <fieldset id="webmail-choice" class="border-0 p-0" hidden>
            <legend class="form-label">Open my message in</legend>
            <label class="form-choice">
              <input type="radio" name="provider" value="gmail" checked />
              <span>Gmail</span>
            </label>
            <label class="form-choice">
              <input type="radio" name="provider" value="outlook" />
              <span>Outlook.com</span>
            </label>
            <label class="form-choice">
              <input type="radio" name="provider" value="yahoo" />
              <span>Yahoo Mail</span>
            </label>
            <label class="form-choice">
              <input type="radio" name="provider" value="app" />
              <span>The email app on this computer</span>
            </label>
          </fieldset>

          <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
            <button type="submit" class="btn btn-cta" id="contact-send">
              <span data-send-label>Open my email</span>
            </button>
            <button type="button" class="btn btn-secondary" id="contact-copy">
              Copy my message
            </button>
          </div>

          <div id="contact-status" class="form-status" role="status" aria-live="polite" hidden></div>
        </form>

        <p class="mt-6 text-muted">
          This form does not send anything by itself, and nothing you type is stored on this website. It only prepares an email in your own email app or webmail. Nothing reaches us until you press Send there. If your email does not open, press <strong>Copy my message</strong> and paste it into any email to {siteConfig.contactEmail}.
        </p>
      </div>

      <NoticeBox title="Privacy and safety note">
          <mark class="notice-highlight">Never include passwords, account numbers, or personal health details.</mark>{" "}
          We use your email address only to reply to you.
      </NoticeBox>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  if (form) {
    const to = form.dataset.to ?? "";
    const subjectInput = document.getElementById("contact-subject") as HTMLInputElement;
    const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement;
    const subjectError = document.getElementById("subject-error") as HTMLElement;
    const messageError = document.getElementById("message-error") as HTMLElement;
    const status = document.getElementById("contact-status") as HTMLElement;
    const copyButton = document.getElementById("contact-copy") as HTMLButtonElement;
    const webmailChoice = document.getElementById("webmail-choice") as HTMLElement;
    const sendLabel = form.querySelector("[data-send-label]") as HTMLElement;

    // Keeps the prepared email link to a length every mail service accepts.
    const MAX_LINK_LENGTH = 3900;

    // Phones and tablets open their mail app; computers open webmail (or the computer's mail app).
    const userAgent = navigator.userAgent || "";
    const uaData = (navigator as Navigator & { userAgentData?: { mobile?: boolean } }).userAgentData;
    const isPhoneOrTablet =
      uaData?.mobile === true ||
      /Android|iPhone|iPad|iPod|Mobile|Tablet|Silk/i.test(userAgent) ||
      (/Macintosh/.test(userAgent) && navigator.maxTouchPoints > 1);

    form.hidden = false;
    if (isPhoneOrTablet) {
      sendLabel.textContent = "Open my email app";
    } else {
      webmailChoice.hidden = false;
    }

    function showStatus(text: string, kind: "info" | "error") {
      status.hidden = false;
      status.dataset.kind = kind;
      status.textContent = text;
    }

    function setFieldError(input: HTMLElement, errorEl: HTMLElement, text: string | null) {
      if (text) {
        errorEl.hidden = false;
        errorEl.textContent = text;
        input.setAttribute("aria-invalid", "true");
      } else {
        errorEl.hidden = true;
        errorEl.textContent = "";
        input.removeAttribute("aria-invalid");
      }
    }

    function clean(value: string) {
      return value.replace(/\r\n?/g, "\n").trim();
    }

    function buildUrl(provider: string, subject: string, body: string) {
      const s = encodeURIComponent(subject);
      const b = encodeURIComponent(body);
      const t = encodeURIComponent(to);
      switch (provider) {
        case "gmail":
          return `https://mail.google.com/mail/?view=cm&fs=1&to=${t}&su=${s}&body=${b}`;
        case "outlook":
          return `https://outlook.live.com/mail/0/deeplink/compose?to=${t}&subject=${s}&body=${b}`;
        case "yahoo":
          return `https://compose.mail.yahoo.com/?to=${t}&subject=${s}&body=${b}`;
        default:
          // mailto: expects CRLF line breaks
          return `mailto:${to}?subject=${s}&body=${b.replace(/%0A/g, "%0D%0A")}`;
      }
    }

    function openLink(url: string, newTab: boolean) {
      const link = document.createElement("a");
      link.href = url;
      if (newTab) {
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      }
      link.style.display = "none";
      document.body.appendChild(link);
      link.click();
      link.remove();
    }

    function validate() {
      const subject = clean(subjectInput.value);
      const body = clean(messageInput.value);
      setFieldError(subjectInput, subjectError, subject ? null : "Please write a subject.");
      setFieldError(messageInput, messageError, body ? null : "Please write your message.");
      if (!subject) {
        subjectInput.focus();
        return null;
      }
      if (!body) {
        messageInput.focus();
        return null;
      }
      return { subject, body };
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const values = validate();
      if (!values) {
        showStatus("Please fill in both boxes, then try again.", "error");
        return;
      }

      const provider = isPhoneOrTablet
        ? "app"
        : (form.querySelector('input[name="provider"]:checked') as HTMLInputElement | null)?.value ?? "gmail";
      const url = buildUrl(provider, values.subject, values.body);

      if (url.length > MAX_LINK_LENGTH) {
        showStatus("Your message is too long for this button. Please shorten it, or press Copy my message and paste it into an email.", "error");
        return;
      }

      openLink(url, provider !== "app");
      showStatus(
        isPhoneOrTablet || provider === "app"
          ? "Your email app should now be open with your message ready. Choose the account to send from, then press Send. If nothing opened, press Copy my message and paste it into an email."
          : "Your email should now be open in a new tab with your message ready. Choose the account to send from, then press Send. If the tab did not open, allow pop-ups for this page or press Copy my message.",
        "info"
      );
    });

    copyButton.addEventListener("click", async () => {
      const values = validate();
      if (!values) {
        showStatus("Please fill in both boxes first, then press Copy my message.", "error");
        return;
      }
      const text = `To: ${to}\nSubject: ${values.subject}\n\n${values.body}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const helper = document.createElement("textarea");
        helper.value = text;
        helper.setAttribute("readonly", "");
        helper.style.position = "fixed";
        helper.style.opacity = "0";
        document.body.appendChild(helper);
        helper.select();
        try {
          document.execCommand("copy");
        } finally {
          helper.remove();
        }
      }
      showStatus(`Copied. Open any email, send it to ${to}, and paste your message.`, "info");
    });

    subjectInput.addEventListener("input", () => setFieldError(subjectInput, subjectError, null));
    messageInput.addEventListener("input", () => setFieldError(messageInput, messageError, null));
  }
</script>
