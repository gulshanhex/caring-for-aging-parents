---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
---
<BaseLayout
  title="Contact Us | Caring for Aging Parents"
  description="Get in touch by email with questions about downloading or printing our large-print family caregiving sheets."
  canonicalPath="/contact/"
  breadcrumbs={[{ label: "Contact", href: "/contact/" }]}
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="prose-measure space-y-8">
      <h1 class="font-serif text-[#015A67]">
        Contact us
      </h1>

      <p class="text-[#111111]">
        If you have a question about one of our printable sheets, need help getting a PDF to print at full size, or had any trouble with your Gumroad download link, please send us an email. We read every message and reply in plain English.
      </p>

      <div class="rounded-xl border-2 border-[#015A67] bg-[#FAF8EC] p-6 sm:p-8">
        <h2 class="font-serif text-[#015A67]">
          Email address
        </h2>
        <p class="mt-3 text-[#111111]">
          You can reach us directly at:
        </p>
        <p class="mt-3 font-serif text-[1.35rem] font-bold">
          <a href={`mailto:${siteConfig.contactEmail}`}>
            {siteConfig.contactEmail}
          </a>
        </p>
      </div>

      <div class="rounded-xl border-2 border-[#52332A] bg-[#FFFFFF] p-6">
        <h2 class="font-serif text-[#015A67]">
          A friendly note on privacy
        </h2>
        <p class="mt-3 text-[#111111]">
          We do not use contact forms that store your message in a third-party database. When you email us, please never include passwords, account numbers, or personal health details in your message.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
