---
import { siteConfig } from "../data/site";
import ShareButton from "./ShareButton.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-link">
      <img
        src="/images/brand/logo-1024.webp"
        width="56"
        height="56"
        alt=""
        loading="eager"
        decoding="async"
        class="brand-logo"
      />
      <span class="brand-title">
        {siteConfig.name}
      </span>
    </a>

    <!-- Desktop navigation; phones and tablets use the fixed app-style bottom navigation. -->
    <nav aria-label="Main navigation" class="desktop-nav">
      <ul class="desktop-nav-list nav-list">
        {
          siteConfig.navLinks.map((link) => {
            const isActive =
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={["desktop-nav-link", isActive && "is-active"]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <ShareButton url={siteConfig.url} title={siteConfig.name} text={siteConfig.tagline} compact />
  </div>
</header>
