---
import { siteConfig } from "../data/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-link">
      <img
        src="/images/brand/logo-1024.webp"
        width="56"
        height="56"
        alt="Caring for Aging Parents mother and daughter logo"
        loading="eager"
        decoding="async"
        class="brand-logo"
      />
      <span class="brand-title">
        {siteConfig.name}
      </span>
    </a>

    <!-- Mobile Navigation (<details> with zero client JS, visible below 768px) -->
    <details class="mobile-nav">
      <summary aria-label="Toggle navigation menu" class="mobile-menu-btn">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <span>Menu</span>
      </summary>
      <nav aria-label="Mobile navigation" class="mobile-nav-panel">
        <ul class="mobile-nav-list nav-list">
          {
            siteConfig.navLinks.map((link) => {
              const isActive =
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href));
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive ? "page" : undefined}
                    class:list={["mobile-nav-link", isActive && "is-active"]}
                  >
                    <span>{link.label}</span>
                    <span aria-hidden="true" class="font-bold">&rarr;</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </details>

    <!-- Tablet & Desktop Navigation (5 large text links, visible from 768px+) -->
    <nav aria-label="Main navigation" class="desktop-nav">
      <ul class="desktop-nav-list nav-list">
        {
          siteConfig.navLinks.map((link) => {
            const isActive =
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={["desktop-nav-link", isActive && "is-active"]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
