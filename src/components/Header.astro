---
import { siteConfig } from "../data/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---
<header class="border-b border-[#D8D5C5] bg-[#FFFFFF]">
  <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-4">
      <a
        href="/"
        class="inline-flex min-h-[52px] items-center gap-3 text-[#015A67] no-underline hover:text-[#014651]"
      >
        <img
          src="/images/brand/logo-1024.webp"
          width="56"
          height="56"
          alt="Caring for Aging Parents mother and daughter logo"
          loading="eager"
          decoding="async"
          class="h-14 w-14 shrink-0 rounded-full border border-[#D8D5C5] bg-[#FAF8EC] object-contain p-1"
        />
        <span class="font-serif text-[1.35rem] font-bold leading-tight text-[#015A67] underline decoration-2 underline-offset-4 sm:text-[1.5rem]">
          {siteConfig.name}
        </span>
      </a>

      <!-- Desktop Navigation (5 large text links) -->
      <nav aria-label="Main navigation" class="hidden md:block">
        <ul class="flex flex-wrap items-center gap-2 lg:gap-4">
          {
            siteConfig.navLinks.map((link) => {
              const isActive =
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href));
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "inline-flex min-h-[52px] items-center rounded-lg px-3.5 py-2.5 text-[1rem] font-bold text-[#015A67] underline decoration-2 underline-offset-4 hover:bg-[#FAF8EC] hover:text-[#014651]",
                      isActive && "bg-[#FAF8EC] decoration-[3px]",
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <!-- Mobile Navigation (<details> with zero client JS) -->
      <details class="mobile-nav relative md:hidden">
        <summary
          aria-label="Toggle navigation menu"
          class="btn btn-secondary min-h-[52px] px-4 py-2.5 text-[#015A67]"
        >
          <span>Menu</span>
          <span aria-hidden="true" class="ml-2 text-[1.1rem] font-bold">+</span>
        </summary>
        <nav
          aria-label="Mobile navigation"
          class="absolute right-0 z-50 mt-2 w-72 rounded-xl border-2 border-[#015A67] bg-[#FFFFFF] p-3"
        >
          <ul class="flex flex-col gap-1">
            {
              siteConfig.navLinks.map((link) => {
                const isActive =
                  currentPath === link.href ||
                  (link.href !== "/" && currentPath.startsWith(link.href));
                return (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isActive ? "page" : undefined}
                      class:list={[
                        "flex min-h-[52px] w-full items-center rounded-lg px-4 py-3 text-[1rem] font-bold text-[#015A67] underline decoration-2 underline-offset-4 hover:bg-[#FAF8EC]",
                        isActive && "bg-[#FAF8EC] decoration-[3px]",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
