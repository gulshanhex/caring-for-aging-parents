---
import type { Product } from "../data/products";
import ShareButton from "./ShareButton.astro";
import { siteConfig } from "../data/site";

interface Props {
  product: Product;
  headingLevel?: "h2" | "h3";
}

const { product, headingLevel = "h3" } = Astro.props;
const HeadingTag = headingLevel;
---
<article class="product-card flex h-full flex-col justify-between rounded-xl border-2 border-warm-border bg-canvas p-6">
  <div class="product-card-main">
    <a href={`/shop/${product.slug}/`} class="product-card-image block overflow-hidden rounded-xl border border-warm-border bg-cream">
      <img
        src={product.image}
        width={product.imageWidth}
        height={product.imageHeight}
        alt={product.imageAlt}
        loading="lazy"
        decoding="async"
        class="h-auto w-full object-cover"
      />
    </a>

    <div class="product-card-copy">
      <div class="mt-5 flex flex-wrap items-center justify-between gap-2">
        <span class="rounded-lg bg-cream px-3 py-1 font-bold text-muted">
          {product.pages} pages &middot; US Letter PDF
        </span>
        <span class="font-serif text-2xl font-bold text-ink">
          {product.price}
        </span>
      </div>

      <HeadingTag class="mt-3 font-serif text-xl font-semibold text-teal">
        <a href={`/shop/${product.slug}/`} class="text-teal underline decoration-2 underline-offset-4 hover:text-teal-hover">
          {product.title}
        </a>
      </HeadingTag>

      <p class="mt-3 text-ink">
        {product.short}
      </p>
      <div class="product-card-share mt-4">
        <ShareButton
          url={new URL(`/shop/${product.slug}/`, siteConfig.url).toString()}
          title={product.title}
          text={product.short}
          label="Share product"
          compact
        />
      </div>
    </div>
  </div>

  <div class="product-card-actions mt-6 flex flex-col gap-3 pt-4">
    <a
      href={product.gumroadUrl}
      class="btn btn-cta w-full text-center"
      rel="noopener noreferrer"
    >
      Buy on Gumroad ({product.price})
    </a>
    <a
      href={`/shop/${product.slug}/`}
      class="btn btn-secondary w-full text-center"
    >
      See what is inside
    </a>
  </div>
</article>
