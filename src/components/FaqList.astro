---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---
<div class="mt-6 space-y-4">
  {
    items.map((item) => (
      <details class="rounded-xl border-2 border-warm-border bg-cream p-5">
        <summary class="font-bold text-teal">
          <span>{item.q}</span>
          <span aria-hidden="true" class="ml-4 text-lg font-bold text-teal">+</span>
        </summary>
        <p class="mt-4 border-t border-warm-border pt-4 text-ink">
          {item.a}
        </p>
      </details>
    ))
  }
</div>
