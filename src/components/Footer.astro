---
import { siteConfig } from "../data/site";
const currentYear = new Date().getFullYear();
const liveSocial = siteConfig.social.filter((item) => item.live);
---
<footer class="mt-16 border-t-2 border-warm-border bg-cream text-ink">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Mandatory non-negotiable organizational disclaimer banner -->
    <div class="mb-10 rounded-xl border-2 border-brown bg-canvas p-6">
      <p class="max-w-prose font-bold text-ink">
        {siteConfig.disclaimerText}
      </p>
      <p class="mt-2 max-w-prose text-muted">
        Read our full <a href="/disclaimer/">Organizational Tools Disclaimer</a> for details on how these printable sheets are intended to be used.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
      <!-- Column 1: Brand & payment note -->
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/images/brand/logo-1024.webp"
            width="48"
            height="48"
            alt=""
            loading="lazy"
            decoding="async"
            class="h-12 w-12 shrink-0 rounded-full border border-warm-border bg-canvas object-contain p-1"
          />
          <span class="font-serif text-xl font-bold text-teal">
            {siteConfig.name}
          </span>
        </div>
        <p class="mt-3 prose-measure text-ink">
          {siteConfig.tagline}.
        </p>
        <p class="mt-4 font-bold text-muted">
          {siteConfig.paymentNotice}
        </p>
      </div>

      <!-- Column 2: Explore links -->
      <nav aria-label="Footer explore links">
        <h2 class="font-serif text-xl font-bold text-teal">
          Printable Sheets &amp; Guides
        </h2>
        <ul class="nav-list mt-3 flex flex-col gap-1">
          {
            siteConfig.navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-12 items-center py-1.5 text-teal underline decoration-2 underline-offset-4 hover:text-teal-hover"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Column 3: Policies & Help links -->
      <nav aria-label="Footer policy and support links">
        <h2 class="font-serif text-xl font-bold text-teal">
          Policies &amp; Questions
        </h2>
        <ul class="nav-list mt-3 flex flex-col gap-1">
          {
            siteConfig.footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-12 items-center py-1.5 text-teal underline decoration-2 underline-offset-4 hover:text-teal-hover"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            liveSocial.map((item) => (
              <li>
                <a
                  href={item.url}
                  rel="noopener noreferrer"
                  class="inline-flex min-h-12 items-center py-1.5 text-teal underline decoration-2 underline-offset-4 hover:text-teal-hover"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-warm-border pt-6 text-muted">
      <p>
        &copy; {currentYear} {siteConfig.name}. All rights reserved. Built for clear, unhurried reading on screen and on paper.
      </p>
    </div>
  </div>
</footer>
